# Streamlit Cloud secrets for chat-with-your-data.
# In the Streamlit dashboard: app settings → Secrets → paste this.
# Get a free key at https://aistudio.google.com/apikey
# (The app uses Gemini automatically when Ollama isn't reachable,
#  so LLM_PROVIDER can be left out entirely.)

GOOGLE_API_KEY = "<redacted>"
GEMINI_MODEL = "gemini-2.0-flash"
